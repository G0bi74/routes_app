{
  "expo": {
    "name": "routes_app",
    "slug": "routes_app",
    "version": "1.0.0",
    "scheme": "routesapp",
    "orientation": "portrait",
    "icon": "./assets/img/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/img/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.routes.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.routes.app"
    },
    "web": {
      "favicon": "./assets/img/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9240e83a-321f-4a76-bc9d-9ff95f8d04af"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
