rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isDocumentOwner() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    function hasValidUserId() {
      return request.resource.data.userId == request.auth.uid;
    }
    
    function validateRouteData() {
      let data = request.resource.data;
      return data.keys().hasAll(['startAddress', 'userId', 'createdAt'])
             && data.startAddress is string
             && data.userId is string
             && data.createdAt is timestamp;
    }
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && hasValidUserId();
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    match /routes/{routeId} {
     
      allow get: if isDocumentOwner();
      
       
      allow list: if isSignedIn();
      
     
      allow create: if isSignedIn() 
                    && hasValidUserId() 
                    && validateRouteData();
      
      
      allow update: if isDocumentOwner() 
                    && hasValidUserId() 
                    && validateRouteData();
      
      
      allow delete: if isDocumentOwner();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
